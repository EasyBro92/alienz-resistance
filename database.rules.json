{
  "rules": {
    ".read": false,
    ".write": false,
    "salas": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null",
        "estado": {
          ".validate": "newData.hasChildren(['t'])"
        },
        "ordenes": {
          "$orden": {
            ".validate": "newData.hasChildren(['tipo'])"
          }
        }
      }
    }
  }
}
