rules_version = '2';
// Cada jugador tiene una sola ficha, jugadores/{uid}, y solo él puede leerla
// y escribirla. Nadie puede listar las fichas de los demás.
service cloud.firestore {
  match /databases/{database}/documents {
    match /jugadores/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.size() < 900 * 1024);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
